    {
      "section": 3,
      "type": "tap",
      "tag": "btn-clear-signals",
      "label": "Clear"
    },
    {
      "section": 3,
      "type": "sleep",
      "ms": 1200
    },
    {
      "section": 3,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countEquals": {
          "key": "timeupdate",
          "value": 0
        },
        "immediate": true
      }
    },
    {
      "section": 3,
      "type": "sleep",
      "ms": 2000
    },
    {
      "section": 4,
      "type": "section",
      "title": "--------Test4: Test seek;-------"
    },
    {
      "section": 4,
      "type": "tap",
      "tag": "btn-clear-signals",
      "label": "Clear"
    },
    {
      "section": 4,
      "type": "tap",
      "tag": "btn-seek",
      "label": "Seek 2s"
    },
    {
      "section": 4,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "seek_ok",
        "timeoutMs": 20000
      }
    },
    {
      "section": 4,
      "type": "sleep",
      "ms": 1200
