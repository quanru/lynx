    },
    {
      "section": 4,
      "type": "video",
      "input": {
        "tag": "time-text",
        "timeoutMs": 5000,
        "currentTimeRange": {
          "min": 2,
          "max": 6,
          "minInclusive": true
        }
      }
    },
    {
      "section": 5,
      "type": "section",
      "title": "--------Test5: Test stop;-------"
    },
    {
      "section": 5,
      "type": "tap",
      "tag": "btn-stop",
      "label": "Stop"
    },
    {
      "section": 5,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "stopped",
        "timeoutMs": 10000,
        "message": "Stop failed"
