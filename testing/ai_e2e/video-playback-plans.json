{
  "basic-playback": [
    {
      "section": 2,
      "type": "section",
      "title": "--------Test2: Test play;-------"
    },
    {
      "section": 2,
      "type": "tap",
      "tag": "btn-clear-signals",
      "label": "Clear"
    },
    {
      "section": 2,
      "type": "tap",
      "tag": "btn-play",
      "label": "Play"
    },
    {
      "section": 2,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "playing",
        "timeoutMs": 10000,
        "message": "Play failed"
      }
    },
    {
      "section": 2,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "play_ok",
        "timeoutMs": 20000
      }
    },
    {
      "section": 2,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countAtLeast": {
          "key": "playing",
          "value": 1
        },
        "timeoutMs": 10000
      }
    },
    {
      "section": 2,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countAtLeast": {
          "key": "timeupdate",
          "value": 1
        },
        "timeoutMs": 10000
      }
    },
    {
      "section": 2,
      "type": "sleep",
      "ms": 3000
    },
    {
      "section": 3,
      "type": "section",
      "title": "--------Test3: Test pause;-------"
    },
    {
      "section": 3,
      "type": "tap",
      "tag": "btn-pause",
      "label": "Pause"
    },
    {
      "section": 3,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "paused",
        "timeoutMs": 10000,
        "message": "Pause failed"
      }
    },
    {
      "section": 3,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "pause_ok",
        "timeoutMs": 20000
