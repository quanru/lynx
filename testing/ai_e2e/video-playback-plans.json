    },
    {
      "section": 5,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "stop_ok",
        "timeoutMs": 20000
      }
    },
    {
      "section": 5,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countAtLeast": {
          "key": "stopped",
          "value": 1
        },
        "timeoutMs": 10000
      }
    },
    {
      "section": 5,
      "type": "tap",
      "tag": "btn-clear-signals",
      "label": "Clear"
    },
    {
      "section": 5,
      "type": "sleep",
      "ms": 1200
    },
    {
      "section": 5,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countEquals": {
          "key": "timeupdate",
          "value": 0
        },
        "immediate": true
      }
    },
    {
      "section": 5,
      "type": "sleep",
      "ms": 2000
    },
    {
      "section": 5,
      "type": "capture",
      "title": "stopped"
    },
    {
      "section": 6,
      "type": "section",
      "title": "--------Test6: Test play after stop;-------"
    },
    {
      "section": 6,
      "type": "tap",
      "tag": "btn-play",
      "label": "Play"
    },
    {
      "section": 6,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "playing",
        "timeoutMs": 10000,
        "message": "Play after stop failed"
      }
    },
    {
      "section": 6,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "play_ok",
        "timeoutMs": 20000
      }
    },
    {
      "section": 6,
      "type": "video",
      "input": {
        "tag": "time-text",
        "timeoutMs": 5000,
        "currentTimeRange": {
          "min": 0,
          "max": 5,
          "minInclusive": false
        }
      }
    },
    {
      "section": 6,
      "type": "sleep",
      "ms": 2000
    },
    {
      "section": 7,
      "type": "section",
      "title": "--------Test7: Test play after ended;-------"
    },
    {
      "section": 7,
      "type": "tap",
      "tag": "btn-clear-signals",
      "label": "Clear"
    },
    {
      "section": 7,
      "type": "tap",
      "tag": "btn-seek-near-end",
      "label": "Near End"
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "seek_ok",
        "timeoutMs": 20000
      }
    },
    {
      "section": 7,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "ended",
        "timeoutMs": 8000,
        "message": "Video did not reach ended state"
      }
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countAtLeast": {
          "key": "ended",
          "value": 1
        },
        "timeoutMs": 10000
      }
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countEquals": {
          "key": "looped",
          "value": 0
        },
        "immediate": true
      }
    },
    {
      "section": 7,
      "type": "tap",
      "tag": "btn-clear-signals",
      "label": "Clear"
    },
    {
      "section": 7,
      "type": "sleep",
      "ms": 1200
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countEquals": {
          "key": "timeupdate",
          "value": 0
        },
        "immediate": true
      }
    },
    {
      "section": 7,
      "type": "tap",
      "tag": "btn-play",
      "label": "Play"
    },
    {
      "section": 7,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "playing",
        "timeoutMs": 5000,
        "message": "Play after ended failed"
      }
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "callback-log",
        "contains": "play_ok",
        "timeoutMs": 20000
      }
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countAtLeast": {
          "key": "playing",
          "value": 1
        },
        "timeoutMs": 10000
      }
    },
    {
      "section": 7,
      "type": "video",
      "input": {
        "tag": "time-text",
        "timeoutMs": 5000,
