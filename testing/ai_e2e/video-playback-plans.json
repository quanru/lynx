          "min": 0,
          "max": 5,
          "minInclusive": false
        }
      }
    },
    {
      "section": 7,
      "type": "sleep",
      "ms": 2000
    }
  ],
  "basic-loop": [
    {
      "section": 9,
      "type": "section",
      "title": "--------Test9: Test play to end with loop;-------"
    },
    {
      "section": 9,
      "type": "tap",
      "tag": "btn-play",
      "label": "Play"
    },
    {
      "section": 9,
      "type": "core",
      "input": {
        "tag": "status-text",
        "text": "playing",
        "timeoutMs": 10000,
        "message": "Loop play failed"
      }
    },
    {
      "section": 9,
      "type": "tap",
      "tag": "btn-seek-near-end",
      "label": "Near End"
    },
    {
      "section": 9,
      "type": "core",
      "input": {
        "tag": "looped-state",
        "text": "looped",
        "timeoutMs": 15000,
        "message": "Loop event not observed"
      }
    },
    {
      "section": 9,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countAtLeast": {
          "key": "looped",
          "value": 1
        },
        "timeoutMs": 10000
      }
    },
    {
      "section": 9,
      "type": "video",
      "input": {
        "tag": "event-counts",
        "countEquals": {
          "key": "ended",
          "value": 0
        },
        "immediate": true
      }
    },
    {
      "section": 9,
      "type": "video",
      "input": {
        "tag": "status-text",
        "equal": "playing",
        "timeoutMs": 20000
      }
    },
    {
      "section": 9,
      "type": "video",
      "input": {
        "tag": "time-text",
        "timeoutMs": 5000,
        "currentTimeRange": {
          "min": 0,
          "max": 5,
          "minInclusive": false
        }
      }
    },
    {
      "section": 9,
      "type": "capture",
      "title": "loop"
    }
  ],
