# OpenAI-compatible multimodal model endpoint. Do not commit a populated .env file.
MIDSCENE_MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
MIDSCENE_MODEL_API_KEY=sk-xxxx
MIDSCENE_MODEL_NAME=your-vl-model
MIDSCENE_MODEL_FAMILY=qwen3
# Optional: some reasoning models require this explicit toggle.
# MIDSCENE_MODEL_REASONING_ENABLED=false
# Optional: override the WDA address for iOS.
# WDA_HOST=localhost
# WDA_PORT=8100
# Optional: select an Android target by adb serial when multiple devices are connected.
# ANDROID_SERIAL=emulator-5554
